# Where uploaded book/KB images are loaded from: azure | aws.
# Must match VECTOR_STORAGE_PROVIDER in backend/knowledgebase/.env.
#   azure -> VITE_IMAGE_BLOB_STORAGE_URL + path + VITE_IMAGE_BLOB_SAS_TOKEN
#   aws   -> <knowledgebase API>/image/<path>, which redirects to a short-lived
#            signed S3 link. Never put AWS keys here: every VITE_* value is
#            visible to anyone in the built JavaScript.
VITE_STORAGE_PROVIDER=azure
# Optional, aws only: a public bucket/CloudFront base URL to use instead of the API.
# VITE_AWS_IMAGE_BASE_URL=
VITE_AZURE_DECRYPT_FUNCTION_URL=${VITE_AZURE_FUNCTION_HOST}/api/EncryptDecryptFunction
